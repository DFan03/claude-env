{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(python3 ~/.claude/tools/deepseek_delegate.py:*)",
      "Bash(python3 ~/.claude/skills/stat-check/validate.py:*)"
    ],
    "deny": [
      "Read(~/.claude/secrets/**)",
      "Bash(cat ~/.claude/secrets/**)",
      "Read(**/.env)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git filter-branch:*)",
      "Bash(git clean:*)",
      "Bash(git remote add:*)",
      "Bash(rm:*)",
      "Bash(rm -rf:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit|mcp__deepseek.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/log_event.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/log_event.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/context_guard.py prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/context_guard.py pre",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/context_guard.py start",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "autoCompactWindow": 200000,
  "theme": "dark"
}
